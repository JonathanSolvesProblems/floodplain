# Copy to .env (gitignored) or export in your shell.
# Nebius Token Factory: https://tokenfactory.nebius.com  (API key + project id; both used by inference and Sandboxes)
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
# Tavily: https://app.tavily.com  (runtime search for upstream migration guidance; optional.
# Without it, the committed research cache is replayed, then the upstream's own migration guide.)
TAVILY_API_KEY=
# Optional model overrides (resolved from /v1/models by substring otherwise)
# FLOODPLAIN_MODEL_NANO=
# FLOODPLAIN_MODEL_SUPER=
# FLOODPLAIN_MODEL_ULTRA=
